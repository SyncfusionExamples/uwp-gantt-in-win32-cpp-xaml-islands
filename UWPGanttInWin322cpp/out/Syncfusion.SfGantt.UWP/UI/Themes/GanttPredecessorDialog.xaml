<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Syncfusion.UI.Xaml.Gantt"
    xmlns:input="using:Syncfusion.UI.Xaml.Controls.Input">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush Color="Black" x:Key="ThemeIconBrush"></SolidColorBrush>
            <SolidColorBrush Color="White" x:Key="FontBrush"></SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush Color="White" x:Key="ThemeIconBrush"></SolidColorBrush>
            <SolidColorBrush Color="#FF636363" x:Key="FontBrush"></SolidColorBrush>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Syncfusion.SfGantt.UWP/Toolbar/Common.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <local:GanttLocalizationConverter x:Key="LocalizationConverter"></local:GanttLocalizationConverter>

    <Style TargetType="local:GanttPredecessorDialog">
        <Setter Property="MaxWidth" Value="500"></Setter>
        <Setter Property="Background" Value="{StaticResource ThemeIconBrush}" ></Setter>
        <Setter Property="VerticalAlignment" Value="Stretch"></Setter>
        <Setter Property="HorizontalAlignment" Value="Stretch"></Setter>
        <Setter Property="FullSizeDesired" Value="True"></Setter>
        <Setter Property="IsPrimaryButtonEnabled" Value="False"></Setter>
        <Setter Property="IsSecondaryButtonEnabled" Value="False"></Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:GanttPredecessorDialog">
                    <Border x:Name="Container">
                        <Grid x:Name="LayoutRoot">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="BackgroundElement"
                                    Background="{TemplateBinding Background}"
                                    FlowDirection="{TemplateBinding FlowDirection}"
                                    BorderThickness="{ThemeResource ContentDialogBorderWidth}"
                                    BorderBrush="{ThemeResource SystemControlForegroundAccentBrush}"
                                    MaxWidth="{TemplateBinding MaxWidth}"
                                    MaxHeight="{TemplateBinding MaxHeight}"
                                    MinWidth="{TemplateBinding MinWidth}"
                                    MinHeight="{TemplateBinding MinHeight}" >
                                <Grid x:Name="DialogSpace" Height="305" VerticalAlignment="Stretch">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <ScrollViewer x:Name="ContentScrollViewer"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Disabled"
                                                  ZoomMode="Disabled"
                                                  Margin="{ThemeResource ContentDialogContentScrollViewerMargin}"
                                                  IsTabStop="False">
                                        <Grid MaxWidth="500" MinHeight="300">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <ContentControl x:Name="Title" Margin="{ThemeResource ContentDialogTitleMargin}"
                                                            Content="{TemplateBinding Title}"
                                                            ContentTemplate="{TemplateBinding TitleTemplate}"
                                                            FontSize="20"
                                                            FontFamily="XamlAutoFontFamily"
                                                            FontWeight="Normal"
                                                            Foreground="{TemplateBinding Foreground}"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Top"
                                                            IsTabStop="False"
                                                            MaxHeight="{ThemeResource ContentDialogTitleMaxHeight}" >
                                                <ContentControl.Template>
                                                    <ControlTemplate TargetType="ContentControl">
                                                        <ContentPresenter Content="{TemplateBinding Content}"
                                                                          MaxLines="2"
                                                                          TextWrapping="Wrap"
                                                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                          Margin="{TemplateBinding Padding}"
                                                                          ContentTransitions="{TemplateBinding ContentTransitions}"
                                                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" >
                                                        </ContentPresenter>
                                                    </ControlTemplate>
                                                </ContentControl.Template>
                                            </ContentControl>
                                            <ContentPresenter x:Name="Content"
                                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                                              FontSize="{ThemeResource ControlContentThemeFontSize}"
                                                              FontFamily="{ThemeResource ContentControlThemeFontFamily}"                                                              
                                                              Foreground="{TemplateBinding Foreground}"
                                                              Grid.Row="1"
                                                              TextWrapping="Wrap" >
                                                <Grid Margin="0" x:Name="mainGrid">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="50" />
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height='80'/>
                                                    </Grid.RowDefinitions>
                                                    <Grid x:Name="childGrid" Grid.Row="0" Height="72">
                                                        <TextBlock Margin="20,0,0,0" x:Name="TaskDependency" FontSize='28' Foreground='#0078d7'
                                                                   HorizontalAlignment = 'Left' FontFamily = 'SegoeUI' FontWeight = 'Light'
                                                                   Text="{Binding ElementName=TaskDependency, Converter={StaticResource LocalizationConverter}}" 
                                                                   Height = '40' VerticalAlignment = 'Center' />
                                                        <Button FontSize='10' Background="Transparent" Width="40" Height="40" Margin="0,0,10,0" Style="{StaticResource CloseButtonsStyle}" x:Name='Close' HorizontalAlignment = 'Right' HorizontalContentAlignment="Center" VerticalContentAlignment="Center" VerticalAlignment = 'Top' >
                                                            <Button.Foreground>
                                                                <SolidColorBrush Color="#000000" Opacity="0.8"></SolidColorBrush>
                                                            </Button.Foreground>
                                                            <Button.Content>
                                                                <SymbolIcon x:Name="Symbol" MaxWidth="20" MaxHeight="20" Foreground="{TemplateBinding Foreground}" Margin='0, 0, 0, 0' Symbol='Cancel'>
                                                                </SymbolIcon>
                                                            </Button.Content>
                                                        </Button>
                                                    </Grid>

                                                    <Grid Grid.Row="1" MaxHeight="180" MinWidth="400" Margin="20,30,20,0">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition/>
                                                            <RowDefinition/>
                                                            <RowDefinition/>
                                                            <RowDefinition/>
                                                            <RowDefinition/>
                                                        </Grid.RowDefinitions>

                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="0.5*"/>
                                                            <ColumnDefinition Width="0.5*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock x:Name="From" Foreground="{StaticResource FontBrush}" Text="{Binding ElementName=From, Converter={StaticResource LocalizationConverter}}" Height="26" VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
                                                            <TextBlock x:Name="StartTaskName" MaxWidth="150" TextTrimming="CharacterEllipsis" 
                                                                       Height="32" VerticalAlignment="Center"
                                                                       HorizontalAlignment="Left"/>
                                                            <TextBlock Text="(" VerticalAlignment="Center" Margin="5,0,0,0" Height="32" HorizontalAlignment="Left"/>
                                                            <TextBlock x:Name="StartTaskID" Height="32" VerticalAlignment="Center"
                                                                       HorizontalAlignment="Left" MaxWidth="50"/>
                                                            <TextBlock Text=")" VerticalAlignment="Center" Height="32" HorizontalAlignment="Left"/>
                                                        </StackPanel>

                                                        <TextBlock x:Name="To" Grid.Column="1" Foreground="{StaticResource FontBrush}" Text="{Binding ElementName=To, Converter={StaticResource LocalizationConverter}}" Height="26" VerticalAlignment="Center" Margin="10,0,0,0"/>

                                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                                            <TextBlock x:Name="EndTaskName" VerticalAlignment="Center" Height="32" MaxWidth="150" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left"/>
                                                            <TextBlock Text="(" VerticalAlignment="Center" Margin="5,0,0,0" Height="32" HorizontalAlignment="Left"/>
                                                            <TextBlock x:Name="EndTaskID" VerticalAlignment="Center" Height="32" TextTrimming="CharacterEllipsis" MaxWidth="50" HorizontalAlignment="Left"/>
                                                            <TextBlock Text=")" VerticalAlignment="Center" Height="32" HorizontalAlignment="Left"/>
                                                        </StackPanel>

                                                        <TextBlock Text="{Binding ElementName=Type, Converter={StaticResource LocalizationConverter}}"
                                                                   Grid.Row="2" Grid.Column="0"
                                                                   x:Name="Type" Foreground="{StaticResource FontBrush}" VerticalAlignment="Center" Height="32" Margin="0,5,0,0"/>

                                                        <ComboBox Height="32" Width="200" VerticalContentAlignment="Center"
                                                                  Grid.Row="3" Grid.Column="0"
                                                                  x:Name="Dependency" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                                        </ComboBox>

                                                        <TextBlock Text="{Binding ElementName=Lag, Converter={StaticResource LocalizationConverter}}"
                                                                   Grid.Row="2" Grid.Column="1"
                                                                   x:Name="Lag" Foreground="{StaticResource FontBrush}" VerticalAlignment="Center" Height="32" Margin="10,5,0,0" HorizontalAlignment="Stretch" />
                                                        
                                                        <input:SfNumericTextBox x:Name="Offset" BlockCharactersOnTextInput="True" Height="32" Width="200" FormatString="0 d" BorderBrush="#999999"
                                                                                Grid.Row="3" Grid.Column="1" Margin="10,0,0,0"
                                                                                MaximumNumberDecimalDigits='0' VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                                                    </Grid>
                                                    
                                                    <Grid Grid.Row="4" Margin="10,30,10,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="0.5*"/>
                                                            <ColumnDefinition Width="0.5*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Button x:Name='Delete' HorizontalAlignment="Left" Style="{StaticResource ToolbarButtonsStyle}" 
                                                                Content="{Binding ElementName=Delete, Converter={StaticResource LocalizationConverter}}"
                                                                Width = '100' Margin="10,0,0,0" />
                                                        <StackPanel HorizontalAlignment='Right' VerticalAlignment='Stretch' Orientation='Horizontal' Grid.Column="1">
                                                            <Button x:Name='Cancel' Style="{StaticResource ToolbarButtonsStyle}" Content="{Binding ElementName=Cancel, Converter={StaticResource LocalizationConverter}}"
                                                                    Width = '100' Margin="10,0,0,0"/>
                                                            <Button x:Name="Save" Style="{StaticResource ToolbarButtonsStyle}" Width = '100' Margin = '10,0,10,0'
                                                                    Content="{Binding ElementName=Save, Converter={StaticResource LocalizationConverter}}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </ContentPresenter>
                                        </Grid>
                                    </ScrollViewer>
                                    <Grid x:Name="CommandSpace" Grid.Row="1" HorizontalAlignment="Stretch" Visibility="Collapsed" VerticalAlignment="Bottom">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="Button1Host"
                                                Margin="{ThemeResource ContentDialogButton1HostMargin}"
                                                MinWidth="{ThemeResource ContentDialogButtonMinWidth}"
                                                MaxWidth="{ThemeResource ContentDialogButtonMaxWidth}"
                                                Height="{ThemeResource ContentDialogButtonHeight}"
                                                HorizontalAlignment="Stretch" />
                                        <Border x:Name="Button2Host"
                                                Margin="{ThemeResource ContentDialogButton2HostMargin}"
                                                MinWidth="{ThemeResource ContentDialogButtonMinWidth}"
                                                MaxWidth="{ThemeResource ContentDialogButtonMaxWidth}"
                                                Height="{ThemeResource ContentDialogButtonHeight}"
                                                Grid.Column="1"
                                                HorizontalAlignment="Stretch" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

