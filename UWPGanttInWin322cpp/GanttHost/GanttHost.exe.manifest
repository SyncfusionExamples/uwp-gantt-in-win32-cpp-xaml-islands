<?xml version="1.0" encoding="utf-8"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1"
          xmlns:asmv3="urn:schemas-microsoft-com:asm.v3"
          manifestVersion="1.0">
  <assemblyIdentity type="win32" name="GanttHost" version="1.0.0.0" />

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Required for XAML Islands: Windows 10 plus maxversiontested >= 10.0.18362.0 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
      <maxversiontested Id="10.0.19041.0" />
    </application>
  </compatibility>

  <asmv3:application>
    <asmv3:windowsSettings>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </asmv3:windowsSettings>
  </asmv3:application>

  <!-- Registration-free WinRT activation of the XAML Islands host. -->
  <asmv3:file name="Microsoft.Toolkit.Win32.UI.XamlHost.dll">
    <activatableClass name="Microsoft.Toolkit.Win32.UI.XamlHost.XamlApplication"
                      threadingModel="both"
                      xmlns="urn:schemas-microsoft-com:winrt.v1" />
  </asmv3:file>
</assembly>
