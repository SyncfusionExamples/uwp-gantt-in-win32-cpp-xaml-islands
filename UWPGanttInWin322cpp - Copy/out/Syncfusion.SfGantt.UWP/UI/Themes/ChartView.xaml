                            <Path Data="F1M15.9999,12.2461L23.1069,17.3091L23.1069,20.1391L8.8939,20.1391L8.8939,17.3091z" Fill="White" Height="7.893" Canvas.Left="0.894" Stretch="Fill" Canvas.Top="1.246" Width="14.213"/>
