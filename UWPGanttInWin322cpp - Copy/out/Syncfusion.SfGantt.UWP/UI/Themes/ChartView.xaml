    <Style TargetType="Thumb" x:Key="TouchRightThumbStyle">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="8"></ColumnDefinition>
                            <ColumnDefinition Width="36"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Border Width="8" Background="#bdbdbd" BorderBrush="DarkGray"
                                Height="30"  Grid.Column="0"></Border>
                        <Grid  Grid.Column="1" Width="36" BorderBrush="DarkGray" Background="#bdbdbd"  Height="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="15"></ColumnDefinition>
                                <ColumnDefinition Width="5"></ColumnDefinition>
                                <ColumnDefinition Width="5"></ColumnDefinition>
                                <ColumnDefinition Width="5"></ColumnDefinition>
                                <ColumnDefinition Width="10"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Rectangle Width="1" Grid.Column="1" Height="15" Fill="White"></Rectangle>
                            <Rectangle Width="1" Grid.Column="2" Height="15" Fill="White"></Rectangle>
                            <Rectangle Width="1" Grid.Column="3" Height="15" Fill="White"></Rectangle>
                        </Grid>
                    </Grid>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Height" Value="30"></Setter>
        <Setter Property="Width" Value="44"></Setter>
    </Style>

    <Style TargetType="Thumb" x:Key="TouchLeftThumbStyle">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="8"></ColumnDefinition>
                                    <ColumnDefinition Width="36"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                        <Border Width="8" Background="#bdbdbd" BorderBrush="DarkGray"
                                Height="30"  Grid.Column="0"></Border>
                        <Grid  Grid.Column="1" Width="36" BorderBrush="DarkGray" Background="#bdbdbd"  Height="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="15"></ColumnDefinition>
                                        <ColumnDefinition Width="5"></ColumnDefinition>
                                        <ColumnDefinition Width="5"></ColumnDefinition>
                                        <ColumnDefinition Width="5"></ColumnDefinition>
                                        <ColumnDefinition Width="10"></ColumnDefinition>
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Width="1" Grid.Column="1" Height="15" Fill="White"></Rectangle>
                                    <Rectangle Width="1" Grid.Column="2" Height="15" Fill="White"></Rectangle>
                                    <Rectangle Width="1" Grid.Column="3" Height="15" Fill="White"></Rectangle>
                                </Grid>
                            </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"></Setter>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TransformGroup>
                    <RotateTransform Angle="180"/>
                </TransformGroup> 
            </Setter.Value>
        </Setter>
        <Setter Property="Height" Value="30"></Setter>
        <Setter Property="Width" Value="44"></Setter>
    </Style>

    <Style TargetType="Thumb" x:Key="RightThumbStyle">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="8"></ColumnDefinition>
                            <ColumnDefinition Width="12"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Border Width="8" Background="#bdbdbd" BorderBrush="#bdbdbd" BorderThickness="2" Height="30"  Grid.Column="0"></Border>
                        <Border Grid.Column="1" Width="12"  Background="#bdbdbd" BorderBrush="#bdbdbd" BorderThickness="2" Height="24">
                            <Rectangle Width="1" Height="15" Fill="White"></Rectangle>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Height" Value="30"></Setter>
        <Setter Property="Width" Value="20"></Setter>
    </Style>

    <DataTemplate x:Key="ToolTipTemplate">
        <Grid  Background="{StaticResource ToolTipBrush}"
                BorderBrush="#CCCBCB"
                BorderThickness="0.5" CornerRadius="3" Padding="4" Width="275">
            <Grid.RowDefinitions>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.52*"></ColumnDefinition>
                <ColumnDefinition Width="0.1*"></ColumnDefinition>
                <ColumnDefinition ></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Text="{Binding [Name]}" Margin="5" Grid.Column="0"/>
            <TextBlock Grid.Row="0" Text=":" Margin="5" Grid.Column="1"/>
            <TextBlock Grid.Row="0" Text="{Binding TaskName}" TextTrimming="CharacterEllipsis"
                       Margin="5" Grid.Column="2"
                       TextAlignment="DetectFromContent"/>
            <TextBlock Grid.Row="1" Text="{Binding [Start date]}" Margin="5" Grid.Column="0"/>
            <TextBlock Grid.Row="1" Text=":" Margin="5" Grid.Column="1"/>
            <TextBlock Grid.Row="1" Margin="5" Text="{Binding StartDate,Converter={StaticResource DateTimeFormatConverter}}" 
                       TextAlignment="DetectFromContent" Grid.Column="2"/>
            <TextBlock Grid.Row="2" Margin="5" Text="{Binding [Finish date]}" Grid.Column="0"/>
            <TextBlock Grid.Row="2" Margin="5" Text=":" Grid.Column="1"/>
            <TextBlock Grid.Row="2" Margin="5" Text="{Binding FinishDate,Converter={StaticResource DateTimeFormatConverter}}" 
                       TextAlignment="DetectFromContent" Grid.Column="2"/>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="TaskToolTipTemplate">
        <Grid  Background="{StaticResource ToolTipBrush}"
                BorderBrush="#CCCBCB"
                BorderThickness="0.5" CornerRadius="3" Padding="4" Width="275">
            <Grid.RowDefinitions>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.52*"></ColumnDefinition>
                <ColumnDefinition Width="0.1*"></ColumnDefinition>
                <ColumnDefinition ></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Text="{Binding [Name]}" Margin="5" Grid.Column="0"/>
            <TextBlock Grid.Row="0" Text=":" Margin="5" Grid.Column="1"/>
            <TextBlock Grid.Row="0" Text="{Binding TaskName}" TextTrimming="CharacterEllipsis"
                       Margin="5" Grid.Column="2"
                       TextAlignment="DetectFromContent"/>
            <TextBlock Grid.Row="1" Text="{Binding [Start date]}" Margin="5" Grid.Column="0"/>
            <TextBlock Grid.Row="1" Text=":" Margin="5" Grid.Column="1"/>
            <TextBlock Grid.Row="1" Margin="5" Text="{Binding StartDate,Converter={StaticResource DateTimeFormatConverter}}" 
                       TextAlignment="DetectFromContent" Grid.Column="2"/>
            <TextBlock Grid.Row="2" Margin="5" Text="{Binding [Finish date]}" Grid.Column="0"/>
            <TextBlock Grid.Row="2" Margin="5" Text=":" Grid.Column="1"/>
            <TextBlock Grid.Row="2" Margin="5" Text="{Binding FinishDate,Converter={StaticResource DateTimeFormatConverter}}" 
                       TextAlignment="DetectFromContent" Grid.Column="2"/>
            <TextBlock Grid.Row="3" Text="{Binding [Progress]}" Margin="5" Grid.Column="0"/>
            <TextBlock Grid.Row="3" Text=":" Margin="5" Grid.Column="1"/>
            <TextBlock Grid.Row="3" Text="{Binding Progress, Converter={StaticResource PercentageConverter}}" Margin="5"
                       Grid.Column="2" TextAlignment="DetectFromContent"/>
        </Grid>
    </DataTemplate>

    <Style TargetType="Thumb" x:Key="LeftThumbStyle">
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"></Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="8"></ColumnDefinition>
                            <ColumnDefinition Width="12"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Border Width="8" Background="#bdbdbd" BorderBrush="#bdbdbd" BorderThickness="2" Height="30"  Grid.Column="0"></Border>
                        <Border Grid.Column="1" Width="12"  Background="#bdbdbd" BorderBrush="#bdbdbd" BorderThickness="2" Height="24">
                            <Rectangle Width="1" Height="15" Fill="White"></Rectangle>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
       <Setter Property="Height" Value="30"></Setter>
        <Setter Property="Width" Value="20"></Setter>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TransformGroup>
                    <RotateTransform Angle="180"/>
                </TransformGroup>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="DragAndDropDefaultToolTipTemplate">
        <Border Background="{StaticResource ToolTipBrush}"
                BorderBrush="#CCCBCB"
                BorderThickness="0.5">
            <Grid Height="Auto" Width="Auto" Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <ContentPresenter VerticalAlignment="Center" Grid.RowSpan="2">
                    <ContentPresenter.Content>
                        <Grid>
                            <Path Height="24" Width="24" Stretch="Fill" Style="{Binding Path=IsValid, Converter={StaticResource VisibilityConverter}}" ></Path>
                        </Grid>
                    </ContentPresenter.Content>
                </ContentPresenter>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding [From]}"  Margin="5,0,5,0"></TextBlock>
                <TextBlock Grid.Row="0" Grid.Column="2" Width="Auto" Text=":"></TextBlock>
                <TextBlock Grid.Row="0" Grid.Column="3" MaxWidth="140" TextTrimming="CharacterEllipsis"
                           Text="{Binding StartIndex}" FontWeight="Bold" Margin="5,0,5,0"></TextBlock>
                <TextBlock Grid.Row="0" Grid.Column="4" Text="{Binding SourcePosition}"  Margin="5,0,5,0"></TextBlock>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding [To]}" Margin="5,0,5,0"></TextBlock>
                <TextBlock Grid.Row="1" Grid.Column="2" Width="Auto" Text=":"></TextBlock>
                <TextBlock Grid.Row="1" Grid.Column="3" MaxWidth="140" TextTrimming="CharacterEllipsis" 
                           Text="{Binding Path=EndIndex}"  FontWeight="Bold" Margin="5,0,5,0"></TextBlock>
                <TextBlock Grid.Row="1" Grid.Column="4" Text="{Binding TargetPosition}"  Margin="5,0,5,0"></TextBlock>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="ProgressTooltipTemplate">
        <Border Background="{StaticResource ToolTipBrush}"
                BorderBrush="#CCCBCB" BorderThickness="1"
                Margin="0"
                VerticalAlignment="Center" Height="30">
            <TextBlock Height="20" Width="Auto" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5"
                       Text="{Binding Progress, Converter={StaticResource PercentageConverter}}"></TextBlock>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="PredecessorValidationTooltipTemplate">
        <Border Background="{StaticResource ToolTipBrush}"
                CornerRadius="3"
                BorderBrush="Black" BorderThickness="1"
                Margin="0"
                VerticalAlignment="Center" Height="30">
            <TextBlock Height="20" Width="Auto" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5"
                       x:Name="NotValidRelationship"
                       Text="{Binding}"></TextBlock>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="StriplineToolTipTemplate">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{Binding Position}"
                       Margin="5"
                       TextAlignment="DetectFromContent"/>
            <TextBlock Grid.Row="1" Margin="5" Text="{Binding Label}"
                       Visibility="{Binding Label, Converter={StaticResource StriplineVisibilityConverter}}"
                       TextAlignment="DetectFromContent"/>
        </Grid>
    </DataTemplate>
    
    <DataTemplate x:Key="StriplineLabelTemplate">
        <Border Background="#0000FF">
            <TextBlock Margin="10,0,10,2" Foreground="#FFFFFF" Text="{Binding Label}"
                       TextAlignment="DetectFromContent"></TextBlock>
        </Border>
    </DataTemplate>

    <Style TargetType="local:ChartView">
        <Setter Property="Background" Value="Transparent"></Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ChartView">
                    <Grid BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
                        <local:AdorningCanvas x:Name="BottomAdorningCanvas"></local:AdorningCanvas>
                        <local:ChartBackgroundPanel x:Name="BackgroundPanel"/>
                        <local:GanttChartSelectionLayer IsHitTestVisible="False"
                                              x:Name="SelectionPanel" />
                        <local:ConnectorPanel x:Name="NodeConnectorPanel" ></local:ConnectorPanel>
                        <local:ChartBasePanel VerticalAlignment="Top" x:Name="ChartBasePanel"  />
                        <Canvas x:Name="AdorningCanvas"></Canvas>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

