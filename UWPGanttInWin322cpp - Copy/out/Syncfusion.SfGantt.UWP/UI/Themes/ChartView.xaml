<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Syncfusion.UI.Xaml.Gantt">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush Color="White" x:Key="EllipseFillBrush"></SolidColorBrush>
            <SolidColorBrush Color="Black" x:Key="ToolTipBrush"></SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush Color="Black" x:Key="EllipseFillBrush"></SolidColorBrush>
            <SolidColorBrush Color="#f2f2f2" x:Key="ToolTipBrush"></SolidColorBrush>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <local:GanttLocalizationConverter x:Key="LocalizationConverter"></local:GanttLocalizationConverter>

    <local:BoolToIconConverter x:Key="VisibilityConverter"></local:BoolToIconConverter>

    <local:DateTimeFormatConverter x:Key="DateTimeFormatConverter"></local:DateTimeFormatConverter>

    <local:PercentageConverter x:Key="PercentageConverter"></local:PercentageConverter>

    <local:StriplineVisibilityConverter x:Key="StriplineVisibilityConverter"></local:StriplineVisibilityConverter>

    <DataTemplate x:Key="ResourceNameTemplate">
        <TextBlock Text="{Binding}"  TextTrimming="CharacterEllipsis" ></TextBlock>
    </DataTemplate>

    <DataTemplate x:Key="TaskNameTemplate">
        <TextBlock Text="{Binding Name}"  TextTrimming="CharacterEllipsis" ></TextBlock>
    </DataTemplate>
    
    <Style TargetType="Ellipse" x:Key="EllipseStyle">
        <Setter Property="Height" Value="12"></Setter>
        <Setter Property="Width" Value="12"></Setter>
        <Setter Property="Fill" Value="{StaticResource EllipseFillBrush}"></Setter>
    </Style>
    
    <Style TargetType="Ellipse" x:Key="TouchEllipseStyle">
        <Setter Property="Height" Value="14"></Setter>
        <Setter Property="Width" Value="14"></Setter>
        <Setter Property="Fill" Value="{StaticResource EllipseFillBrush}"></Setter>
    </Style>

