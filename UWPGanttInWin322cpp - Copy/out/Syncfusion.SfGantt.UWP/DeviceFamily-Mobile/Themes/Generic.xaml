<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"    
    xmlns:input="using:Syncfusion.UI.Xaml.Controls.Input"
    xmlns:treeGrid="using:Syncfusion.UI.Xaml.TreeGrid"
    xmlns:grid="using:Syncfusion.UI.Xaml.Grid"
    xmlns:utils="using:Syncfusion.UI.Xaml.Utils"
    xmlns:navigation="using:Syncfusion.UI.Xaml.Controls.Navigation"
    xmlns:local="using:Syncfusion.UI.Xaml.Gantt">
    
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="ToolbarBrush" Color="Transparent"></SolidColorBrush>
            <SolidColorBrush x:Key="HeaderRowBrush" Color="#2B2B2B"></SolidColorBrush>
            <SolidColorBrush x:Key="ExpanderColorBrush" Color="White"></SolidColorBrush>
            <SolidColorBrush x:Key="ParentProgressIndicatorBrush" Color="#F2F2F2"></SolidColorBrush>
            <SolidColorBrush x:Key="MilestoneBrush" Color="White"></SolidColorBrush>
            <SolidColorBrush x:Key="NonWorkingDaysBackgroundBrush" Color="#2B2B2B"></SolidColorBrush>
            <SolidColorBrush x:Key="SelectionForegroundBrush" Color="White"></SolidColorBrush>
            <SolidColorBrush x:Key="SelectionListBoxBackgroundBrush" Color="#676767"></SolidColorBrush>
            <SolidColorBrush x:Key="SelectionListBoxBorderBrush" Color="#767676"></SolidColorBrush>
            <SolidColorBrush x:Key="IconBrush" Color="White"></SolidColorBrush>
            <SolidColorBrush x:Key="GanttBorderBrush" Color="#2B2B2B"></SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="ToolbarBrush" Color="#F2F2F2"></SolidColorBrush>
            <SolidColorBrush x:Key="HeaderRowBrush" Color="#e6e6e6"></SolidColorBrush>
            <SolidColorBrush x:Key="ExpanderColorBrush" Color="#FF0F0F0F"></SolidColorBrush>
            <SolidColorBrush x:Key="ParentProgressIndicatorBrush" Color="#333333"></SolidColorBrush>
            <SolidColorBrush x:Key="MilestoneBrush" Color="#666666"></SolidColorBrush>
            <SolidColorBrush x:Key="NonWorkingDaysBackgroundBrush" Color="#F9F9F9"></SolidColorBrush>
            <SolidColorBrush x:Key="SelectionForegroundBrush" Color="Black"></SolidColorBrush>
            <SolidColorBrush x:Key="SelectionListBoxBackgroundBrush" Color="#F2F2F2"></SolidColorBrush>
            <SolidColorBrush x:Key="SelectionListBoxBorderBrush" Color="#CCCBCB"></SolidColorBrush>
            <SolidColorBrush x:Key="IconBrush" Color="Black"></SolidColorBrush>
            <SolidColorBrush x:Key="GanttBorderBrush" Color="#e6e6e6"></SolidColorBrush>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary   Source="ms-appx:///Syncfusion.SfGrid.UWP/SfTreeGrid/Themes/Generic.xaml" />
        <ResourceDictionary   Source="ms-appx:///Syncfusion.SfGantt.UWP/UI/Themes/GanttChart.xaml" />
        <ResourceDictionary   Source="ms-appx:///Syncfusion.SfGantt.UWP/UI/Themes/Timescale.xaml" />
        <ResourceDictionary   Source="ms-appx:///Syncfusion.SfGantt.UWP/UI/Themes/ChartView.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <local:FontWeightConverter x:Key="FontWeightConverter"/>

    <grid:BoolToVisiblityConverter x:Key="BoolToVisiblityConverter" />

    <grid:SortDirectionToVisibilityConverter x:Key="SortDirectionToVisibilityConverter" />

    <grid:SortDirectionToWidthConverter x:Key="SortDirectionToWidthConverter" />

    <local:GanttLocalizationConverter x:Key="GanttLocalizationConverter"/>

    <Style x:Key="HeaderStyle" TargetType="treeGrid:TreeGridHeaderCell">
        <Setter Property="Background" Value="{StaticResource HeaderRowBrush}"></Setter>
        <Setter Property="FontFamily" Value="SegoeUI"></Setter>
        <Setter Property="FontSize" Value="15"></Setter>
        <Setter Property="BorderBrush" Value="#737373"></Setter>
        <Setter Property="BorderThickness" Value="0,0,0.4,0"></Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="treeGrid:TreeGridHeaderCell">
                    <Grid x:Name="PART_HeaderCellBorder"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="HiddenColumnsResizingStates">
                                <VisualState x:Name="NormalState" />
                                <VisualState x:Name="LastColumnHidden">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_HeaderCellBorder" Storyboard.TargetProperty="BorderThickness">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="0,0,3,1" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="HiddenState">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_HeaderCellBorder" Storyboard.TargetProperty="BorderThickness">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="3,0,3,1" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="PreviousColumnHidden">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_HeaderCellBorder" Storyboard.TargetProperty="BorderThickness">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="3,0,1,1" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="PointerOver" />
                                <VisualState x:Name="Normal" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"
                                          FontFamily="{TemplateBinding FontFamily}"
                                          FontSize="{TemplateBinding FontSize}"
                                          FontWeight="{TemplateBinding FontWeight}" />

                        <Grid x:Name="PART_SortButtonPresenter" Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0" MinWidth="{Binding Path=SortDirection, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource SortDirectionToWidthConverter}}" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Width="10.84"
                                  Height="18"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M16,0L32,10.399998 27.799988,13.199987 19,7.5000025 19,29.299997 13,29.299997 13,7.5000025 4.2999878,13.199987 0,10.399998z"
                                  Fill="{StaticResource ApplicationForegroundThemeBrush}"
                                  Stretch="Fill"
                                  Visibility="{Binding Path=SortDirection,
                                                       RelativeSource={RelativeSource TemplatedParent},
                                                       ConverterParameter=Ascending,
                                                       Converter={StaticResource SortDirectionToVisibilityConverter}}">
                                <Path.RenderTransform>
                                    <TransformGroup>
                                        <TransformGroup.Children>
                                            <RotateTransform Angle="0" />
                                            <ScaleTransform ScaleX="1" ScaleY="1" />
                                        </TransformGroup.Children>
                                    </TransformGroup>
                                </Path.RenderTransform>
                            </Path>

                            <Path Width="10.84"
                                  Height="16"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M13.281003,0L18.465999,0 18.465999,24.891006 31.652,15.460007 31.652,20.709 15.874004,32 12.203,29.372009 0,20.637009 0,15.526001 0.094009396,15.460007 13.281003,24.891006z"
                                  Fill="{StaticResource ApplicationForegroundThemeBrush}"
                                  Stretch="Fill"
                                  Visibility="{Binding Path=SortDirection,
                                                       RelativeSource={RelativeSource TemplatedParent},
                                                       ConverterParameter=Decending,
                                                       Converter={StaticResource SortDirectionToVisibilityConverter}}">
                                <Path.RenderTransform>
                                    <TransformGroup>
                                        <TransformGroup.Children>
                                            <RotateTransform Angle="0" />
                                            <ScaleTransform ScaleX="1" ScaleY="1" />
                                        </TransformGroup.Children>
                                    </TransformGroup>
                                </Path.RenderTransform>
                            </Path>
                            <TextBlock Grid.Column="1"
                                       Margin="0,-4,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="10"
                                       Foreground="{TemplateBinding Foreground}"
                                       Text="{TemplateBinding SortNumber}"
                                       Visibility="{TemplateBinding SortNumberVisibility}" />
                        </Grid>

                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CellStyle" TargetType="treeGrid:TreeGridCell">
        <Setter Property="BorderBrush" Value="#737373"></Setter>
        <Setter Property="BorderThickness" Value="0,0,0.4,0.4"></Setter>
    </Style>
    
    <Style x:Key="GanttGridStyle" TargetType="local:GanttGrid">
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"></Setter>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden"></Setter>
        <Setter Property="CellStyle" Value="{StaticResource CellStyle}"></Setter>
        <Setter Property="AutoGenerateColumns" Value="False"></Setter>
        <Setter Property="AllowEditing" Value="False"></Setter>                
        <Setter Property="AllowSorting" Value="False"></Setter>        
        <Setter Property="AutoExpandMode" Value="AllNodesExpanded"></Setter>                     
        <Setter Property="ShowRowHeader" Value="True"></Setter>
        <Setter Property="BorderThickness" Value="0"></Setter>
        <Setter Property="CurrentCellBorderThickness" Value="0"></Setter>
        <Setter Property="SelectionBackground" Value="#0078d7"></Setter>
        <Setter Property="HeaderStyle" Value="{StaticResource HeaderStyle}"></Setter>
    </Style>

    <Style x:Key="GanttChartStyle" TargetType="local:GanttChart">
        <Setter Property="BorderBrush" Value="LightGray"></Setter>
        <Setter Property="Background" Value="Transparent"></Setter>
        <Setter Property="BorderThickness" Value="1"></Setter>
    </Style>

    <Style TargetType="local:SfGantt">
        <Setter Property="SelectionBackground" Value="{ThemeResource SystemControlHighlightListAccentHighBrush}"></Setter>
        <Setter Property="BorderBrush" Value="{StaticResource GanttBorderBrush}"/>
        <Setter Property="ProjectResources">
            <Setter.Value>
                <local:GanttResourceCollection></local:GanttResourceCollection>
            </Setter.Value>
        </Setter>
        <Setter Property="Striplines">
            <Setter.Value>
                <local:GanttStriplineCollection></local:GanttStriplineCollection>
            </Setter.Value>
        </Setter>
        <Setter Property="ToolbarIconBrush" Value="{StaticResource IconBrush}"></Setter>
        <Setter Property="NonWorkingDaysBackground" Value="{StaticResource NonWorkingDaysBackgroundBrush}"></Setter>
        <Setter Property="ParentProgressIndicatorBrush" Value="{StaticResource ParentProgressIndicatorBrush}"/>
        <Setter Property="MilestoneBrush" Value="{StaticResource MilestoneBrush}"/>
        <Setter Property="SelectionForeground" Value="{StaticResource SelectionForegroundBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:SfGantt">
                    <Border Margin="{TemplateBinding Margin}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <local:GanttDockPanel x:Name="RootDockPanel">
                            <local:GanttDockPanel.RootElement>
                        <Grid x:Name="RootPanel">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="50"></RowDefinition>
                                <RowDefinition Height="*"></RowDefinition>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="10"  VerticalAlignment="Center" x:Name="SelectionGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                                    <ColumnDefinition Width="50"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Width="Auto" 
                                           FontFamily="SegoeUI"                                        
                                           FontWeight="SemiLight"
                                           FontSize="24"     
                                           x:Name="textBlock"
                                           TextAlignment="Center"
                                           VerticalAlignment="Center" 
                                           Text="{Binding [Grid view], RelativeSource={RelativeSource Mode=TemplatedParent}}"  />
                                <Grid Grid.Column="1" Background="Transparent">
                                    <Path x:Name="DropDownArrow" Stretch="Fill" Fill="{StaticResource IconBrush}" 
                                          Data="F1 M 77.0484,56.0446L 78.2203,57.2165L 65.1383,70.3024L 52.0575,57.2165L 53.2294,56.0446L 65.1383,67.9587L 77.0484,56.0446 Z " 
                                          Height="12" Width="22"/>
                                </Grid>

                                <Popup IsLightDismissEnabled="True" Grid.ColumnSpan="2">
                                    <Border BorderBrush="{StaticResource SelectionListBoxBorderBrush}" BorderThickness="1" 
                                            Background="{StaticResource SelectionListBoxBackgroundBrush}">
                                        <ListBox  FontFamily="SegoeUI"
                                                  FontWeight="SemiLight" Padding="15,7,15,7"
                                                  SelectedIndex="0" Width="160"
                                                  x:Name="listBox" >
                                            <ListBoxItem VerticalAlignment="Center"
                                                         Height="44"
                                                         VerticalContentAlignment="Center">
                                                <ListBoxItem.Template>
                                                    <ControlTemplate>
                                                        <Grid Background="{TemplateBinding Background}">
                                                            <VisualStateManager.VisualStateGroups>
                                                                <VisualStateGroup x:Name="CommonStates">
                                                                    <VisualState x:Name="SelectedUnfocused">
                                                                        <Storyboard>
                                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Foreground" Storyboard.TargetName="SelectionIndicator">
                                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#0078d7" />
                                                                            </ObjectAnimationUsingKeyFrames>
                                                                        </Storyboard>
                                                                    </VisualState>
                                                                    <VisualState x:Name="Normal">
                                                                        <Storyboard>
                                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Foreground" Storyboard.TargetName="SelectionIndicator">
                                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{TemplateBinding Background}" />
                                                                            </ObjectAnimationUsingKeyFrames>
                                                                        </Storyboard>
                                                                    </VisualState>
                                                                </VisualStateGroup>
                                                            </VisualStateManager.VisualStateGroups>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="20"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                                <Path Margin="0,0,10,0"  Height="16" Width="16" 
                                                                      HorizontalAlignment="Left" VerticalAlignment="Center" 
                                                                      Stretch="Uniform" Fill="{StaticResource IconBrush}" 
                                                                      Data="F1M15,5L11,5 11,1 15,1z M15,10L11,10 11,6 15,6z M15,15L11,15 11,11 15,11z M10,5L6,5 6,1 10,1z M10,10L6,10 6,6 10,6z M10,15L6,15 6,11 10,11z M5,5L1,5 1,1 5,1z M5,10L1,10 1,6 5,6z M5,15L1,15 1,11 5,11z M0,16L16,16 16,0 0,0z"/>
                                                                <TextBlock x:Name="GridView"
                                                                           Text="{Binding ElementName=GridView, Converter={StaticResource GanttLocalizationConverter}}" 
                                                                           FontSize="15" VerticalAlignment="Center" ></TextBlock>
                                                            </StackPanel>
                                                            <SymbolIcon x:Name="SelectionIndicator" Grid.Column="1" Symbol="Accept" HorizontalAlignment="Right"></SymbolIcon>
                                                        </Grid>
                                                    </ControlTemplate>
                                                </ListBoxItem.Template>
                                            </ListBoxItem>
                                            <ListBoxItem VerticalAlignment="Center" Height="44">
                                                <ListBoxItem.Template>
                                                    <ControlTemplate>
                                                        <Grid Background="{TemplateBinding Background}">
                                                            <VisualStateManager.VisualStateGroups>
                                                                <VisualStateGroup x:Name="CommonStates">
                                                                    <VisualState x:Name="SelectedUnfocused">
                                                                        <Storyboard>
                                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Foreground" Storyboard.TargetName="SelectionIndicator">
                                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#0078d7" />
                                                                            </ObjectAnimationUsingKeyFrames>
                                                                        </Storyboard>
                                                                    </VisualState>
                                                                    <VisualState x:Name="Normal">
                                                                        <Storyboard>
                                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Foreground" Storyboard.TargetName="SelectionIndicator">
                                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{TemplateBinding Background}" />
                                                                            </ObjectAnimationUsingKeyFrames>
                                                                        </Storyboard>
                                                                    </VisualState>
                                                                </VisualStateGroup>
                                                            </VisualStateManager.VisualStateGroups>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="20"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                                <Path Margin="0,0,10,0" Height="16" Width="16" 
                                                                      HorizontalAlignment="Left" VerticalAlignment="Center" 
                                                                      Stretch="Uniform" Fill="{StaticResource IconBrush}" 
                                                                      Data="F1 M 74.9333,68.6667L 66.4,68.6667L 65.3333,68.6667L 65.3333,69.7331L 63.2,69.7331L 63.2,65.4665L 69.6,65.4665L 70.6667,65.4665L 70.6667,64.3997L 70.6667,62.2666L 70.6667,61.1999L 69.6,61.1999L 61.0667,61.1999L 60,61.1999L 60,62.2666L 57.8666,62.2666L 57.8666,58L 64.2667,58L 65.3333,58L 65.3333,56.9333L 65.3333,54.7998L 65.3333,53.7331L 64.2667,53.7331L 55.7333,53.7331L 54.6667,53.7331L 54.6667,54.7998L 54.6667,56.9333L 54.6667,58L 55.7333,58L 56.8,58L 56.8,62.2666L 56.8,63.3333L 57.8666,63.3333L 60,63.3333L 60,64.3997L 60,65.4665L 61.0667,65.4665L 62.1333,65.4665L 62.1333,69.7331L 62.1333,70.7998L 63.2,70.7998L 65.3333,70.7998L 65.3333,71.8665L 65.3333,72.9333L 66.4,72.9333L 74.9333,72.9333L 76,72.9333L 76,71.8665L 76,69.7331L 76,68.6667L 74.9333,68.6667 Z M 55.7333,56.9333L 55.7333,54.7998L 64.2667,54.7998L 64.2667,56.9333L 55.7333,56.9333 Z M 61.0667,64.3997L 61.0667,63.3333L 61.0667,62.2666L 69.6,62.2666L 69.6,64.3997L 61.0667,64.3997 Z M 74.9333,71.8665L 66.4,71.8665L 66.4,70.7998L 66.4,69.7331L 74.9333,69.7331L 74.9333,71.8665 Z"/>
                                                                <TextBlock x:Name="GanttView" 
                                                                           Text="{Binding ElementName=GanttView, Converter={StaticResource GanttLocalizationConverter}}" 
                                                                           FontSize="15" VerticalAlignment="Center" ></TextBlock>
                                                            </StackPanel>
                                                            <SymbolIcon x:Name="SelectionIndicator" Grid.Column="1" Symbol="Accept" HorizontalAlignment="Right"></SymbolIcon>
                                                        </Grid>
                                                    </ControlTemplate>
                                                </ListBoxItem.Template>
                                            </ListBoxItem>
                                        </ListBox>
                                    </Border>
                                </Popup>
                            </Grid>

                              <local:GanttGrid x:Name="GanttGrid" Grid.Row="1" BorderThickness="0"
                                               Style="{StaticResource GanttGridStyle}" >
                                <local:GanttGrid.Resources>
                                  <Style TargetType="treeGrid:TreeGridRowHeaderIndentCell">
                                    <Setter Property="Background" Value="{StaticResource HeaderRowBrush}"></Setter>
                                    <Setter Property="BorderBrush" Value="#737373"></Setter>
                                    <Setter Property="BorderThickness" Value="0,0,0.4,0"></Setter>
                                  </Style>

                                  <Style TargetType="treeGrid:TreeGridRowHeaderCell">
                                    <Setter Property="FontFamily" Value="SegoeUI"></Setter>
                                    <Setter Property="FontSize" Value="15"></Setter>
                                    <Setter Property="BorderBrush" Value="#737373"></Setter>
                                    <Setter Property="BorderThickness" Value="0,0,0.4,0.4"></Setter>
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="IsTabStop" Value="False" />
                                    <Setter Property="Template">
                                      <Setter.Value>
                                        <ControlTemplate TargetType="treeGrid:TreeGridRowHeaderCell">
                                          <Border x:Name="PART_RowHeaderCellBorder"
                                                  Background="{TemplateBinding Background}"
                                                  BorderBrush="{TemplateBinding BorderBrush}"
                                                  BorderThickness="{TemplateBinding BorderThickness}">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding RowIndex,RelativeSource={RelativeSource Mode=TemplatedParent}}"/>
                                          </Border>
                                        </ControlTemplate>
                                      </Setter.Value>
                                    </Setter>
                                  </Style>

                                  <Style TargetType="treeGrid:TreeGridRowControl">
                                    <Setter Property="FontFamily" Value="SegoeUI" />
                                    <Setter Property="FontSize" Value="15" />
                                    <Setter Property="BorderBrush" Value="#737373"></Setter>
                                    <Setter Property="BorderThickness" Value="0,0,0,0"></Setter>
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="utils:SetterValueBindingHelper.PropertyBinding">
                                      <Setter.Value>
                                        <utils:SetterValueBindingHelper Binding="{Binding Path=DataRow.HasChildNodes, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource FontWeightConverter}}" Property="FontWeight" />
                                      </Setter.Value>
                                    </Setter>
                                    <Setter Property="Template">
                                      <Setter.Value>
                                        <ControlTemplate TargetType="treeGrid:TreeGridRowControl">
                                          <Grid BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <Border x:Name="PART_BackgroundBorder"
                                                    Background="{TemplateBinding Background}"
                                                    Visibility="Visible">
                                              <Rectangle x:Name="PART_FocusRect"
                                                         Margin="1,2,2,2"
                                                         Fill="Transparent"
                                                         Stroke="DarkGray"
                                                         StrokeDashArray="2,2"
                                                         StrokeThickness="1"
                                                         Visibility="Collapsed" />
                                            </Border>
                                            <Border x:Name="PART_SelectionBorder"
                                                    Background="{TemplateBinding SelectionBackground}"
                                                    Visibility="Collapsed" />
                                            <ContentPresenter />
                                            <VisualStateManager.VisualStateGroups>
                                              <VisualStateGroup x:Name="SelectionStates">
                                                <VisualState x:Name="Unselected" />
                                                <VisualState x:Name="Selected">
                                                  <VisualState.Setters>
                                                    <Setter Target="PART_SelectionBorder.Visibility" Value="Visible" />
                                                  </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="SelectedPointerOver">
                                                  <VisualState.Setters>
                                                    <Setter Target="PART_SelectionBorder.Visibility" Value="Visible" />
                                                  </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="SelectedPressed">
                                                  <VisualState.Setters>
                                                    <Setter Target="PART_SelectionBorder.Visibility" Value="Visible" />
                                                  </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="UnselectedPointerOver" />
                                                <VisualState x:Name="UnselectedPressed" />
                                                <VisualState x:Name="Focused">
                                                  <VisualState.Setters>
                                                    <Setter Target="PART_FocusRect.Visibility" Value="Visible" />
                                                  </VisualState.Setters>
                                                </VisualState>
                                              </VisualStateGroup>
                                            </VisualStateManager.VisualStateGroups>
                                          </Grid>
                                        </ControlTemplate>
                                      </Setter.Value>
                                    </Setter>
                                  </Style>

                                  <Style TargetType="treeGrid:TreeGridExpander">
                                    <Setter Property="Foreground" Value="{StaticResource ApplicationForegroundThemeBrush}" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="IsTabStop" Value="False" />
                                    <Setter Property="Template">
                                      <Setter.Value>
                                        <ControlTemplate TargetType="treeGrid:TreeGridExpander">
                                          <Border Background="Transparent"
                                                  BorderBrush="{TemplateBinding BorderBrush}"
                                                  BorderThickness="{TemplateBinding BorderThickness}">
                                              <VisualStateManager.VisualStateGroups>
                                                  <VisualStateGroup x:Name="ExpandedState">
                                                      <VisualState x:Name="Expanded">
                                                          <Storyboard>
                                                              <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_CollapseCellPath"
                                                                                             Storyboard.TargetProperty="(FrameworkElement.Visibility)">
                                                                  <DiscreteObjectKeyFrame KeyTime="0:0:0">
                                                                      <DiscreteObjectKeyFrame.Value>
                                                                          <Visibility>Collapsed</Visibility>
                                                                      </DiscreteObjectKeyFrame.Value>
                                                                  </DiscreteObjectKeyFrame>
                                                    </ObjectAnimationUsingKeyFrames>
                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_ExpanderCellPath"
                                                                                   Storyboard.TargetProperty="(FrameworkElement.Visibility)">
                                                      <DiscreteObjectKeyFrame KeyTime="0:0:0">
                                                          <DiscreteObjectKeyFrame.Value>
                                                              <Visibility>Visible</Visibility>
                                                        </DiscreteObjectKeyFrame.Value>
                                                      </DiscreteObjectKeyFrame>
                                                    </ObjectAnimationUsingKeyFrames>
                                                  </Storyboard>
                                                </VisualState>
                                                <VisualState x:Name="Collapsed">
                                                  <Storyboard>
                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_ExpanderCellPath"
                                                                                   Storyboard.TargetProperty="(FrameworkElement.Visibility)">
                                                        <DiscreteObjectKeyFrame KeyTime="0:0:0">
                                                            <DiscreteObjectKeyFrame.Value>
                                                                <Visibility>Collapsed</Visibility>
                                                            </DiscreteObjectKeyFrame.Value>
                                                        </DiscreteObjectKeyFrame>
                                                    </ObjectAnimationUsingKeyFrames>
                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_CollapseCellPath"
                                                                                   Storyboard.TargetProperty="(FrameworkElement.Visibility)">
                                                      <DiscreteObjectKeyFrame KeyTime="0:0:0">
                                                          <DiscreteObjectKeyFrame.Value>
                                                              <Visibility>Visible</Visibility>
                                                        </DiscreteObjectKeyFrame.Value>
                                                      </DiscreteObjectKeyFrame>
                                                    </ObjectAnimationUsingKeyFrames>
                                                  </Storyboard>
                                                </VisualState>
